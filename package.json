{
  "name": "imagemetrics-tool",
  "version": "2.0.0",
  "description": "Web-based image measurement tool for precise pixel-level coordinate, distance, and color analysis",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "serve -l 8080 .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "image",
    "measurement",
    "pixel",
    "coordinates",
    "color",
    "canvas"
  ],
  "author": "Abdulkareem Alaboud <abo.saleh.g@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abosalehg-ui/ImageMetrics-Tool.git"
  },
  "homepage": "https://abosalehg-ui.github.io/ImageMetrics-Tool/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
